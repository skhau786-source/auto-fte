# Application
APP_NAME="Digital FTE Agent"
APP_VERSION="1.0.0"
ENV="development"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5434/digital_fte"

# Redis (Event Bus)
REDIS_URL="redis://localhost:6380/0"
REDIS_PASSWORD=""

# Orchestrator
ORCHESTRATOR_URL="http://localhost:8000"
AGENT_TOKEN=""

# JWT Auth
SECRET_KEY="replace-with-a-very-strong-secret-key-32-chars-minimum"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=""

# CORS & Frontend
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
FRONTEND_URL="http://localhost:3000"
BACKEND_PUBLIC_URL="http://localhost:8000"
FRONTEND_SUCCESS_URL="http://localhost:3000/dashboard"

# Email SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# LLM & Encryption
LLM_API_KEY=""
LLM_MODEL="gemini-2.0-flash-exp"
ENCRYPTION_KEY=""

# Platform OAuth
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_SCOPES="read_products,read_orders"
SHOPIFY_REDIRECT_URI="http://localhost:8000/api/v1/auth/shopify/callback"

# Shopify Storefront API token (Headless / custom app -> Storefront API access token).
# Required for the chatbot's "add to cart". Empty = the bot says cart isn't set up and hands off to a human.
STOREFRONT_ACCESS_TOKEN=""

WOOCOMMERCE_REDIRECT_URI="http://localhost:8000/api/v1/auth/woocommerce/callback"

BIGCOMMERCE_CLIENT_ID=""
BIGCOMMERCE_CLIENT_SECRET=""
BIGCOMMERCE_REDIRECT_URI="http://localhost:8000/api/v1/auth/bigcommerce/callback"

AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_REDIRECT_URI="http://localhost:8000/api/v1/auth/amazon/callback"
AMAZON_REFRESH_TOKEN=""

DARAZ_APP_KEY=""
DARAZ_APP_SECRET=""
DARAZ_REDIRECT_URI="http://localhost:8000/api/v1/auth/daraz/callback"

# Content & Social
GEMINI_API_KEY=""
DALLE_API_KEY=""
IMAGE_MODEL_DEFAULT="gemini-2.0-flash-exp"

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Public website chat (anonymous visitors) — all optional, these are the defaults
# PUBLIC_CHAT_ENABLED=True
# PUBLIC_CHAT_MAX_QUERY_CHARS=1000
# PUBLIC_CHAT_SESSION_TTL_DAYS=30
# PUBLIC_CHAT_CHAT_PER_IP_PER_MINUTE=30
# PUBLIC_CHAT_CHAT_PER_SESSION_PER_MINUTE=10
# PUBLIC_CHAT_POLL_PER_IP_PER_MINUTE=120
# PUBLIC_CHAT_POLL_PER_SESSION_PER_MINUTE=30
# PUBLIC_CHAT_NEW_SESSIONS_PER_IP_PER_HOUR=20
# Set True only behind a trusted reverse proxy (otherwise X-Forwarded-For can be spoofed)
# TRUST_PROXY_HEADERS=False
