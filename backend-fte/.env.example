# ═══════════════════════════════════════════════════════════════════
# Application
# ═══════════════════════════════════════════════════════════════════
APP_NAME="Digital FTE Inventory Management"
ENV=development                  # development | staging | production
DEBUG=true

# ═══════════════════════════════════════════════════════════════════
# Database (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/digital_fte"

# ═══════════════════════════════════════════════════════════════════
# Redis (Token blacklist + caching)
# ═══════════════════════════════════════════════════════════════════
REDIS_URL="redis://:password@localhost:6379/0"

# ═══════════════════════════════════════════════════════════════════
# JWT Authentication
# ═══════════════════════════════════════════════════════════════════
SECRET_KEY="change-me-to-a-random-secret"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ═══════════════════════════════════════════════════════════════════
# Google OAuth
# ═══════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID="your-google-client-id"

# ═══════════════════════════════════════════════════════════════════
# Shopify API
# ═══════════════════════════════════════════════════════════════════
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"
SHOPIFY_WEBHOOK_SECRET="your-shopify-webhook-secret"
SHOPIFY_API_VERSION="2024-07"

# ═══════════════════════════════════════════════════════════════════
# CORS (Comma-separated origins)
# ═══════════════════════════════════════════════════════════════════
CORS_ORIGINS="http://localhost:3000,https://your-app.com"
TRUSTED_HOSTS="localhost,127.0.0.1"

# ═══════════════════════════════════════════════════════════════════
# Inventory Sync
# ═══════════════════════════════════════════════════════════════════
SYNC_INTERVAL_HOURS=6
LOW_STOCK_ALERT_THRESHOLD=10
SYNC_RETRY_MINUTES=5

# ═══════════════════════════════════════════════════════════════════
# Rate Limiting
# ═══════════════════════════════════════════════════════════════════
RATE_LIMIT_PER_MINUTE=60

# ═══════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | text


# ── Added in merged-all (leave empty to keep the feature disabled) ──
# LLM for AI agents (either one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI post generation (Instagram module)
GROQ_API_KEY=
HUGGINGFACE_API_TOKEN=
# Instagram / Meta Graph API
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# SMTP email notifications
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
