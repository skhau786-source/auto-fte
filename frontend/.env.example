# Backend API base URL used by the browser (no trailing slash)
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Google sign-in (OAuth Web client ID; same value as GOOGLE_CLIENT_ID in Backend/.env)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Optional: which chatbot widget loads by default ("free" or "pro")
# NEXT_PUBLIC_CHATBOT_PLAN="free"
